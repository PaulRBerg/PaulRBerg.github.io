{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prberg-site",
  "account_id": "3b418eb22e5ff2587487eb749b253ac1",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "prberg.com", "custom_domain": true },
    { "pattern": "www.prberg.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
