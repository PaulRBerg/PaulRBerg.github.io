                x="393"
                y="276"
                text-anchor="middle"
                fill="currentColor"
                fill-opacity=".6"
                font-family="ui-monospace, monospace"
                font-size="13"
                letter-spacing="1.5"
                >SOLIDITY</text
              >
            </g>

            <path
              d="M240 282V301H393V282"
              stroke="currentColor"
              stroke-opacity=".22"
              stroke-width="2"
            />
            <circle cx="240" cy="301" r="4" fill="var(--accent)" />
            <path
              d="M178 307H210M218 307H262M270 307H302"
              stroke="currentColor"
              stroke-opacity=".18"
              stroke-width="3"
              stroke-linecap="round"
            />
          </svg>
        </div>
      </div>
    </section>

    <section
      class="grid gap-8 border-b border-border py-10 sm:grid-cols-[minmax(0,12rem)_1fr] sm:gap-12 sm:py-12"
    >
      <h2 class="text-2xl font-semibold">How I can help</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        <li class="rounded-xl border border-border bg-foreground/[0.025] p-5">
          <h3 class="flex items-center gap-2 font-semibold">
            <IconDeviceLaptop
              width={19}
              height={19}
              class="text-accent"
              aria-hidden="true"
            />Product
            engineering
          </h3>
          <p class="mt-3 leading-7 text-foreground/75">
            Build and improve web and mobile applications, from user-facing features to the systems
            that support them.
          </p>
        </li>
        <li class="rounded-xl border border-border bg-foreground/[0.025] p-5">
          <h3 class="flex items-center gap-2 font-semibold">
            <IconServer2 width={19} height={19} class="text-accent" aria-hidden="true" />Backend and
            infrastructure
          </h3>
          <p class="mt-3 leading-7 text-foreground/75">
            Design and implement APIs, services, and reliable application infrastructure.
          </p>
        </li>
        <li class="rounded-xl border border-border bg-foreground/[0.025] p-5">
          <h3 class="flex items-center gap-2 font-semibold">
            <IconCode width={19} height={19} class="text-accent" aria-hidden="true" />Smart
            contracts
          </h3>
          <p class="mt-3 leading-7 text-foreground/75">
            Develop Solidity systems and supporting software for onchain products.
          </p>
        </li>
        <li class="rounded-xl border border-border bg-foreground/[0.025] p-5">
          <h3 class="flex items-center gap-2 font-semibold">
            <IconTool width={19} height={19} class="text-accent" aria-hidden="true" />Developer
            tooling
          </h3>
          <p class="mt-3 leading-7 text-foreground/75">
            Create libraries and tools that make software development clearer and more effective.
          </p>
        </li>
      </ul>
    </section>

    <section
      class="grid gap-8 border-b border-border py-10 sm:grid-cols-[minmax(0,12rem)_1fr] sm:gap-12 sm:py-12"
    >
      <h2 class="text-2xl font-semibold">Selected work</h2>
      <ul class="space-y-5 leading-7 text-foreground/80">
        <li>
          <a
            class="font-semibold text-accent underline underline-offset-4"
            href="https://sablier.com"
            >Sablier<IconExternalLink width={15} height={15} class="ml-1 inline" aria-hidden="true"
          /></a>
          <span> — co-founded the software company.</span>
        </li>
        <li>
          <a
            class="font-semibold text-accent underline underline-offset-4"
            href="https://github.com/PaulRBerg/prb-math"
            >PRBMath<IconExternalLink width={15} height={15} class="ml-1 inline" aria-hidden="true"
          /></a>
          <span> — created an open-source fixed-point math library for Solidity.</span>
        </li>
      </ul>
    </section>

    <section class="grid gap-8 py-10 sm:grid-cols-[minmax(0,12rem)_1fr] sm:gap-12 sm:py-12">
      <h2 class="text-2xl font-semibold">Business details</h2>
      <address class="space-y-2 not-italic leading-7 text-foreground/80">
        <p class="font-semibold text-foreground">Berg Paul Razvan Persoana Fizica Autorizata</p>
        <p>Bulevardul Bucurestii Noi 136, Ap 5, Parter, Sector 1, Bucuresti 012366, Romania</p>
        <p>CUI: 54640718</p>
        <p>Trade Registry: F2026024079002</p>
        <p>
          Phone:
          <a class="underline underline-offset-4 hover:text-accent" href="tel:+40738833995"
            >+40738833995</a
          >
        </p>
        <p>
          Email:
          <a class="underline underline-offset-4 hover:text-accent" href="mailto:prberg@proton.me"
            >prberg@proton.me</a
          >
        </p>
      </address>
    </section>
  </main>
</SiteShell>
