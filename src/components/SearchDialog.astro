<div id="site-search" data-pagefind-ignore>
  <pagefind-config
    instance="site-search"
    bundle-path="/pagefind/"
    highlight-param="highlight"
  ></pagefind-config>
  <pagefind-modal instance="site-search">
    <pagefind-modal-header>
      <pagefind-input instance="site-search" placeholder="Search articles…"></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary instance="site-search"></pagefind-summary>
      <pagefind-results instance="site-search"></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints instance="site-search"></pagefind-keyboard-hints>
      <a class="search-page-link" href="/search" data-search-page-link>Open search page</a>
      <button class="search-close" type="button" data-search-close>Close</button>
    </pagefind-modal-footer>
  </pagefind-modal>
</div>
