---
import { Font } from "astro:assets";
import type { ImageMetadata } from "astro";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { ClientRouter } from "astro:transitions";
import SearchDialog from "@/components/SearchDialog.astro";
import { SITE } from "@/config";
import { markdownURL, pageURL, serializeStructuredData, socialImageURL } from "@/utils/seo";
import "@/styles/global.css";
import "@pagefind/component-ui/css/pagefind-component-ui.css";
import "@/styles/search.css";

interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  ogImageMetadata?: ImageMetadata;
  ogImageAlt?: string;
  twitterImage?: string;
  canonicalURL?: string | URL;
  noindex?: boolean;
  ogType?: "website" | "article";
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  ogImageMetadata,
  ogImageAlt = title,
  twitterImage = ogImage,
  canonicalURL,
  noindex = false,
  ogType = "website",
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  structuredData,
} = Astro.props;

const canonicalHref = pageURL(Astro.url.pathname, canonicalURL);
const imageURL = socialImageURL(ogImage);
const twitterImageURL = socialImageURL(twitterImage);
const imageFormat = ogImageMetadata?.format;
let imageMimeType = imageFormat ? `image/${imageFormat}` : undefined;
if (imageFormat === "jpg") {
  imageMimeType = "image/jpeg";
} else if (imageFormat === "svg") {
  imageMimeType = "image/svg+xml";
}
---

<!doctype html>
<html dir={SITE.dir} lang={SITE.lang || "en"} class:list={{ "scroll-smooth": scrollSmooth }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="help" type="text/plain" href="/llms.txt" title="Site guide for language models" />
    {!noindex && (
      <link
        rel="alternate"
        type="text/markdown"
        href={markdownURL(Astro.url.pathname)}
        title="Markdown"
      />
    )}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="generator" content={Astro.generator} />

    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageMetadata && <meta property="og:image:width" content={String(ogImageMetadata.width)} />}
    {ogImageMetadata && (
      <meta property="og:image:height" content={String(ogImageMetadata.height)} />
    )}
    {imageMimeType && <meta property="og:image:type" content={imageMimeType} />}

    {pubDatetime && <meta property="article:published_time" content={pubDatetime.toISOString()} />}
    {modDatetime && <meta property="article:modified_time" content={modDatetime.toISOString()} />}

    <meta name="twitter:site" content="@PaulRBerg" />
    <meta name="twitter:creator" content="@PaulRBerg" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalHref} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={twitterImageURL} />
    <meta property="twitter:image:alt" content={ogImageAlt} />

    {structuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializeStructuredData(structuredData)}
      />
    )}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site).toString()}
    />

    <meta name="theme-color" content="" />

    {PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    <ClientRouter />
    <script is:inline src="/scripts/analytics.js" defer></script>
    <script is:inline>
      (() => {
        let themeValue = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        try {
          const preference = localStorage.getItem("theme");
          if (preference === "dark" || preference === "light") {
            themeValue = preference;
          }
        } catch {
          // Use the system theme when browser storage is unavailable.
        }

        document.documentElement.dataset.theme = themeValue;

        window.theme = {
          ...window.theme,
          getTheme: () => window.theme?.themeValue ?? themeValue,
          setTheme: (val) => {
            window.theme.themeValue = val;
          },
          themeValue,
        };
      })();
    </script>
  </head>
  <body>
    <slot />
    <SearchDialog />
    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/navigation.ts"></script>
    <script src="../scripts/search.ts"></script>
  </body>
</html>
